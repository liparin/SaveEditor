function CalcCRC32(const Data: TBytes; StartOffset, Length: Int64): Cardinal;
var
  i: Int64;
begin
  Result := $FFFFFFFF;
  for i := StartOffset to StartOffset + Length - 1 do
  begin
    if i >= System.Length(Data) then
      Break;
    Result := (Result shr 8) xor CRC32Table[(Data[i] xor (Result and $FF)) and $FF];
  end;
  Result := Result xor $FFFFFFFF;
end;

end.
